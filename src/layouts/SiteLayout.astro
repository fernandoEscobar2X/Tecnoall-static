---
import QRCode from 'qrcode';
import QuoteRequest from '@components/islands/QuoteRequest';
import WhatsAppLauncher from '@components/islands/WhatsAppLauncher';
import SeoHead from '@components/seo/SeoHead.astro';
import SiteFooter from '@components/site/SiteFooter.astro';
import SiteHeader from '@components/site/SiteHeader.astro';
import { homeContent } from '@/content/home';
import { siteConfig } from '@config/site';
import type { SeoInput } from '@lib/seo/types';
import '@styles/global.css';
import '@styles/corporate.css';
import '@styles/pages.css';
import '@styles/control-panels.css';

interface Props {
  seo: SeoInput;
}

const { seo } = Astro.props;
const whatsappQrSvg = await QRCode.toString(homeContent.contact.whatsappHref, {
  type: 'svg',
  errorCorrectionLevel: 'M',
  margin: 1,
  width: 176,
  color: { dark: '#1b3954', light: '#ffffff' },
});
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="low"
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-condensed-700-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="low"
    />
    <SeoHead {...seo} />
  </head>
  <body class="corporate-body">
    <a class="corporate-skip" href="#main-content">Saltar al contenido</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <QuoteRequest client:load whatsappHref={homeContent.contact.whatsappHref} />
    <WhatsAppLauncher client:idle href={homeContent.contact.whatsappHref} qrSvg={whatsappQrSvg} />

    <script>
      const header = document.querySelector<HTMLElement>('[data-site-header]');
      const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');
      const compactQuery = window.matchMedia('(max-width: 1180px)');
      let lastScrollY = window.scrollY;

      const updateHeader = () => {
        if (!header) return;
        const y = window.scrollY;
        const menuOpen = mobileMenu?.dataset.open === 'true';
        const compact = compactQuery.matches;
        const goingDown = y > lastScrollY + 4;
        const goingUp = y < lastScrollY - 4;

        if (!compact) {
          header.classList.toggle('is-scrolled', y > 12);
          header.classList.remove('is-solid');

          if (menuOpen || y < 24) {
            header.classList.remove('is-hidden');
          } else if (goingDown && y > 72) {
            header.classList.add('is-hidden');
          } else if (goingUp) {
            header.classList.remove('is-hidden');
          }
        } else {
          header.classList.remove('is-scrolled');

          if (menuOpen || y < 32) {
            header.classList.remove('is-hidden');
            header.classList.remove('is-solid');
          } else if (goingDown && y > 40) {
            header.classList.add('is-hidden');
          } else if (goingUp) {
            header.classList.remove('is-hidden');
            header.classList.add('is-solid');
          }
        }

        lastScrollY = y;
      };

      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });

      const revealElements = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
      const navigationEntry = performance.getEntriesByType('navigation')[0] as
        PerformanceNavigationTiming | undefined;
      const isRestoredNavigation =
        navigationEntry?.type === 'reload' || navigationEntry?.type === 'back_forward';
      let revealObserver: IntersectionObserver | undefined;

      const revealAll = () => {
        revealObserver?.disconnect();
        revealElements.forEach((element) => {
          element.classList.remove('reveal-pending');
          element.classList.add('is-visible');
        });
      };

      const revealCurrentViewport = () => {
        const viewportHeight = window.visualViewport?.height ?? window.innerHeight;
        revealElements.forEach((element) => {
          const rect = element.getBoundingClientRect();
          if (rect.top < viewportHeight * 1.08 && rect.bottom > -40) {
            element.classList.add('is-visible');
          }
        });
      };

      if (
        !isRestoredNavigation &&
        'IntersectionObserver' in window &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        revealCurrentViewport();
        revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              revealObserver?.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px 22% 0px', threshold: 0.01 },
        );
        revealElements.forEach((element) => {
          if (!element.classList.contains('is-visible')) {
            element.classList.add('reveal-pending');
            revealObserver?.observe(element);
          }
        });
      } else {
        revealAll();
      }

      const syncRestoredViewport = (restored = false) => {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            updateHeader();
            if (restored || isRestoredNavigation) {
              revealAll();
              return;
            }
            revealCurrentViewport();
          });
        });
      };
      window.addEventListener('pageshow', (event) => syncRestoredViewport(event.persisted));
      window.addEventListener('load', () => syncRestoredViewport(false), { once: true });
      document.documentElement.dataset.appReady = 'true';
    </script>
  </body>
</html>
