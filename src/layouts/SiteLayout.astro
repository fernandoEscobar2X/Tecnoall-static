---
import QRCode from 'qrcode';
import QuoteRequest from '@components/islands/QuoteRequest';
import WhatsAppLauncher from '@components/islands/WhatsAppLauncher';
import SeoHead from '@components/seo/SeoHead.astro';
import SiteFooter from '@components/site/SiteFooter.astro';
import SiteHeader from '@components/site/SiteHeader.astro';
import { homeContent } from '@/content/home';
import { siteConfig } from '@config/site';
import type { SeoInput } from '@lib/seo/types';
import '@styles/global.css';
import '@styles/corporate.css';
import '@styles/pages.css';
import '@styles/control-panels.css';
import '@styles/mobile-nav.css';

interface Props {
  seo: SeoInput;
}

const { seo } = Astro.props;
const whatsappQrSvg = await QRCode.toString(homeContent.contact.whatsappHref, {
  type: 'svg',
  errorCorrectionLevel: 'M',
  margin: 1,
  width: 176,
  color: { dark: '#1b3954', light: '#ffffff' },
});
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbfcfd" />
    <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="low"
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-condensed-600-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
      fetchpriority="low"
    />
    <SeoHead {...seo} />
  </head>
  <body class="corporate-body">
    <a class="corporate-skip" href="#main-content">Saltar al contenido</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <QuoteRequest client:load whatsappHref={homeContent.contact.whatsappHref} />
    <WhatsAppLauncher client:idle href={homeContent.contact.whatsappHref} qrSvg={whatsappQrSvg} />

    <script>
      import { initReveals, ScrollTrigger, startSmoothScroll } from '@lib/motion';

      startSmoothScroll();
      void initReveals();

      // El header se oculta al bajar y reaparece al subir, como siempre. ScrollTrigger lee la
      // misma posición que Lenis.
      const header = document.querySelector<HTMLElement>('[data-site-header]');
      const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');
      if (header) {
        ScrollTrigger.create({
          start: 0,
          end: 'max',
          onUpdate: (self) => {
            const y = self.scroll();
            header.classList.toggle('is-scrolled', y > 12);
            if (mobileMenu?.dataset.open === 'true' || y < 72) header.classList.remove('is-hidden');
            else if (self.direction === 1) header.classList.add('is-hidden');
            else header.classList.remove('is-hidden');
          },
        });
      }

      document.documentElement.dataset.appReady = 'true';
    </script>
  </body>
</html>
