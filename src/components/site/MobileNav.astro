---
import UiIcon from '@components/ui/UiIcon.astro';
import type { NavItem } from '@config/navigation';
import { storeUrl } from '@config/navigation';

interface Props {
  items: readonly NavItem[];
}
const { items } = Astro.props;
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href;
---

<div class="site-menu" data-open="false" data-mobile-menu>
  <button
    class="site-menu__toggle site-header__island"
    type="button"
    aria-expanded="false"
    aria-controls="mobile-navigation-panel"
    aria-haspopup="dialog"
    aria-label="Abrir menú"
    data-menu-toggle
  >
    <span>Menú</span>
    <span class="mobile-header__menu-glyph" aria-hidden="true"><span></span><span></span></span>
  </button>

  <dialog
    class="mobile-drawer"
    id="mobile-navigation-panel"
    aria-labelledby="mobile-menu-title"
    data-menu-panel
    data-lenis-prevent
  >
    <div class="mobile-drawer__head">
      <strong id="mobile-menu-title">Explorar Tecno All</strong>
      <button class="mobile-drawer__close" type="button" aria-label="Cerrar menú" data-menu-close>
        <UiIcon name="xmark" />
      </button>
    </div>
    <div class="mobile-drawer__scroll">
      <nav class="mobile-drawer__nav" aria-label="Navegación móvil">
        <a class="mobile-drawer__item" href="/" aria-current={isCurrent('/') ? 'page' : undefined}
          >Inicio</a
        >
        {
          items.map((item) =>
            item.links || item.columns ? (
              <details class="mobile-drawer__group" name="mobile-navigation">
                <summary>
                  {item.label}
                  <span class="mobile-drawer__chevron" aria-hidden="true" />
                </summary>
                <div class="mobile-drawer__links">
                  <a
                    class="mobile-drawer__all"
                    href={item.href}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                  >
                    {item.columns ? 'Ver todo el catálogo' : 'Ver todas las soluciones'}
                  </a>
                  {item.links?.map((link) => (
                    <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                      {link.label}
                    </a>
                  ))}
                  {item.columns?.map((column) => (
                    <div class="mobile-drawer__brand">
                      <a class="mobile-drawer__brand-title" href={column.href}>
                        {column.label}
                      </a>
                      {column.links.map((link) => (
                        <a href={link.href}>{link.label}</a>
                      ))}
                    </div>
                  ))}
                </div>
              </details>
            ) : (
              <a
                class="mobile-drawer__item"
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ),
          )
        }
        <a class="mobile-drawer__item" href="/empresa/#escribanos">Contacto y sedes</a>
      </nav>
      <nav class="mobile-drawer__shortcuts" aria-label="Secciones de inicio">
        <a href="/#servicios">Servicios</a>
        <a href="/#productos">Equipo industrial</a>
        <a href="/#contacto">Hablemos de su proyecto</a>
      </nav>
      {
        storeUrl ? (
          <a class="mobile-drawer__store" href={storeUrl}>
            Tienda
          </a>
        ) : (
          <span class="mobile-drawer__store" aria-disabled="true">
            Tienda · próximamente
          </span>
        )
      }
      <nav class="mobile-drawer__legal" aria-label="Documentos legales">
        <a href="/aviso-de-privacidad/">Aviso de privacidad</a>
        <a href="/terminos-y-condiciones/">Términos y condiciones</a>
      </nav>
    </div>
    <div class="mobile-drawer__actions">
      <button type="button" data-open-quote>Solicitar cotización</button>
    </div>
  </dialog>
</div>

<script>
  import { lockScroll } from '@lib/scroll-lock';

  const root = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const toggle = root?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = root?.querySelector<HTMLDialogElement>('[data-menu-panel]');
  if (root && toggle && panel) {
    let previousOverflow = '';
    const releasePage = () => {
      if (root.dataset.open !== 'true') return;
      root.dataset.open = 'false';
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = previousOverflow;
      lockScroll(false);
    };
    const closeMenu = () => {
      if (panel.open) {
        releasePage();
        panel.close();
      }
    };
    const openMenu = () => {
      if (panel.open) return;
      previousOverflow = document.body.style.overflow;
      panel.showModal();
      panel.querySelector<HTMLButtonElement>('[data-menu-close]')?.focus();
      root.dataset.open = 'true';
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      lockScroll(true);
      panel.querySelector<HTMLElement>('.mobile-drawer__scroll')?.scrollTo({ top: 0 });
    };
    toggle.addEventListener('click', openMenu);
    panel.addEventListener('close', releasePage);
    panel.addEventListener('click', (event) => {
      const target = event.target as Element;
      if (target.closest('a, [data-menu-close], [data-open-quote]')) closeMenu();
      if (target === panel) {
        const box = panel.getBoundingClientRect();
        if (
          event.clientX < box.left ||
          event.clientX > box.right ||
          event.clientY < box.top ||
          event.clientY > box.bottom
        )
          closeMenu();
      }
    });
    window.matchMedia('(min-width: 1181px)').addEventListener('change', (event) => {
      if (event.matches) closeMenu();
    });
  }
</script>
