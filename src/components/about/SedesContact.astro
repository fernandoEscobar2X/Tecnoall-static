---
import { homeContent as c } from '@/content/home';
import UiIcon from '@components/ui/UiIcon.astro';
---

<section id="escribanos" class="sedes-contact" aria-labelledby="sedes-contact-title">
  <div class="sedes-contact__head">
    <h2 id="sedes-contact-title">Dos sedes en Baja California</h2>
  </div>

  <div class="sedes-contact__grid" data-location-experience>
    <div class="sedes-contact__map">
      <div class="sedes-contact__map-toolbar">
        <div class="location-switcher" role="tablist" aria-label="Sedes Tecno All">
          {
            c.trust.locations.map((location, index) => (
              <button
                id={`location-tab-${index}`}
                type="button"
                role="tab"
                data-location-trigger={index}
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`location-panel-${index}`}
                tabindex={index === 0 ? 0 : -1}
                class:list={{ 'is-active': index === 0 }}
              >
                <strong>{location.city}</strong>
              </button>
            ))
          }
        </div>
      </div>
      <div class="sedes-contact__map-stage">
        {
          c.trust.locations.map((location, index) => (
            <div data-location-map={index} hidden={index !== 0}>
              <iframe
                data-map-frame
                data-map-source={index === 0 ? c.maps.tijuana : c.maps.mexicali}
                title={`Mapa de Tecno All ${location.city}`}
                width="100%"
                height="540"
                style="border:0"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              />
            </div>
          ))
        }
      </div>
      {
        c.trust.locations.map((location, index) => (
          <div
            id={`location-panel-${index}`}
            class="sedes-contact__sede"
            role="tabpanel"
            aria-labelledby={`location-tab-${index}`}
            data-location-panel={index}
            hidden={index !== 0}
          >
            <div class="sedes-contact__sede-id">
              <h3>{location.city}</h3>
            </div>
            <address>{location.address}</address>
            <div class="sedes-contact__sede-actions">
              <a href={location.phoneHref}>{location.phone}</a>
              <a
                class="sedes-contact__route"
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location.address)}`}
                target="_blank"
                rel="noreferrer"
              >
                Abrir indicaciones <UiIcon name="openNewWindow" />
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <div class="sedes-contact__card">
      <h3>Escríbanos</h3>
      <p>
        Comparta el requerimiento de su planta. Le respondemos con una propuesta y el siguiente
        paso.
      </p>

      <form
        class="request-form"
        name="contacto"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="website"
        data-contact-form
        data-whatsapp-href={c.contact.whatsappHref}
      >
        <input type="hidden" name="form-name" value="contacto" />
        <input
          type="hidden"
          name="subject"
          value="[Tecno All] Nuevo contacto · %{submissionId}"
          data-remove-prefix
        />
        <input type="hidden" name="origen" value="Sobre nosotros" />
        <input type="hidden" name="pagina" value="" />
        <input type="hidden" name="fecha_envio" value="" />
        <p class="netlify-honeypot" aria-hidden="true">
          <label
            >No llenar este campo: <input name="website" autocomplete="off" tabindex="-1" /></label
          >
        </p>
        <div class="request-form__row">
          <label>
            <span>Nombre <em aria-hidden="true">*</em></span>
            <input
              type="text"
              name="nombre"
              autocomplete="name"
              placeholder="Nombre completo"
              maxlength="100"
              required
            />
          </label>
          <label>
            <span>Empresa</span>
            <input
              type="text"
              name="empresa"
              autocomplete="organization"
              placeholder="Nombre empresa"
              maxlength="120"
            />
          </label>
        </div>

        <div class="request-form__row">
          <label>
            <span>Correo <em aria-hidden="true">*</em></span>
            <input
              type="email"
              name="email"
              autocomplete="email"
              placeholder="nombre@empresa.com"
              maxlength="254"
              required
            />
          </label>
          <label>
            <span>Teléfono</span>
            <input
              type="tel"
              name="telefono"
              autocomplete="tel"
              placeholder="(664) 000 0000"
              maxlength="30"
            />
          </label>
        </div>

        <label>
          <span>Tipo de solicitud</span>
          <select name="tipo_solicitud">
            <option>Proyecto de automatización</option>
            <option>Suministro industrial</option>
            <option>Servicio o mantenimiento</option>
            <option>Otro</option>
          </select>
        </label>

        <label>
          <span>Requerimiento <em aria-hidden="true">*</em></span>
          <textarea
            name="requerimiento"
            rows="4"
            maxlength="4000"
            placeholder="Describa el proceso, el equipo instalado o los productos que necesita."
            required></textarea>
        </label>

        <p class="form-privacy-note">
          Al enviar sus datos, acepta su tratamiento para atender esta solicitud conforme al
          <a href="/aviso-de-privacidad/">aviso de privacidad</a>.
        </p>

        <div class="request-form__actions">
          <button class="request-form__send" type="submit" name="canal" value="email">
            Enviar solicitud
          </button>
          <button class="request-form__alt" type="submit" name="canal" value="whatsapp">
            Enviarla por WhatsApp
          </button>
        </div>
        <p class="request-form__status" data-contact-status aria-live="polite"></p>
      </form>

      <div class="sedes-contact__direct">
        <a href={c.contact.emailHref}>{c.contact.email}</a>
        <a href={c.contact.whatsappHref} target="_blank" rel="noreferrer">
          WhatsApp {c.contact.whatsapp}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { initializeLocationExperiences } from '@lib/location-experience';

  initializeLocationExperiences();
</script>

<script>
  import { submitNetlifyForm } from '@lib/netlify-forms';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-contact-status]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('nombre') ?? '');
    const company = String(data.get('empresa') ?? '');
    const email = String(data.get('email') ?? '');
    const phone = String(data.get('telefono') ?? '');
    const requestType = String(data.get('tipo_solicitud') ?? 'Otro');
    const message = String(data.get('requerimiento') ?? '');
    const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
    const whatsappHref = form.dataset.whatsappHref ?? '';
    const body = `${requestType}\n\nNombre: ${name}\nEmpresa: ${company || 'No indicada'}\nCorreo: ${email}\nTeléfono: ${phone || 'No indicado'}\n\nRequerimiento:\n${message}`;

    if (submitter?.value === 'whatsapp' && whatsappHref) {
      const separator = whatsappHref.includes('?') ? '&' : '?';
      window.open(
        `${whatsappHref}${separator}text=${encodeURIComponent(body)}`,
        '_blank',
        'noopener',
      );
      return;
    }

    const submitButtons = [...form.querySelectorAll<HTMLButtonElement>('button[type="submit"]')];
    submitButtons.forEach((button) => (button.disabled = true));
    if (status) status.textContent = 'Enviando solicitud…';
    data.set('pagina', window.location.href);
    data.set('fecha_envio', new Date().toISOString());
    data.set('canal', 'Correo');

    try {
      await submitNetlifyForm('contacto', data);
      form.reset();
      if (status) status.textContent = 'Solicitud recibida. Nos pondremos en contacto.';
    } catch {
      if (status) {
        status.textContent = 'No fue posible enviar. Intente de nuevo o utilice WhatsApp.';
      }
    } finally {
      submitButtons.forEach((button) => (button.disabled = false));
    }
  });
</script>
