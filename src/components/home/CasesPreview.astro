---
import HomeCase from '@components/islands/HomeCase';
import { caseStudies } from '@/content/cases';
import { createResponsiveMedia } from '@lib/responsive-media';

const featured = caseStudies[0];
const phrase = featured?.homePhrase;
const shot = featured
  ? await createResponsiveMedia({
      src: featured.image,
      widths: [720, 1080, 1440, 1920],
      sizes: '100vw',
      alt: featured.imageAlt,
      quality: 85,
    })
  : undefined;
---

{
  featured && phrase && shot && (
    <HomeCase
      client:visible
      imageSrc={shot.src}
      imageSrcSet={shot.srcSet}
      imageSizes={shot.sizes}
      imageWidth={shot.width}
      imageHeight={shot.height}
      imageAlt={shot.alt}
      voice={`${featured.year}, ${featured.location}`}
      title={featured.title}
      body="Módulo 4 de la planta. Paneles de control, automatización y telemetría entregados en abril de 2019."
      statValue={phrase.statValue}
      statUnit={phrase.statUnit}
      statLabel={phrase.statLabel}
      href={`/casos-de-exito/#${featured.slug}`}
    />
  )
}
