---
import SolutionsRoster from '@components/home/SolutionsRoster';
import { homeContent as c } from '@/content/home';
import { solutionSlugs } from '@/content/routes';
import { createResponsiveMedia } from '@lib/responsive-media';

const items = await Promise.all(
  c.solutions.map(async (service) => ({
    id: service.id,
    index: service.index,
    title: service.title,
    shortTitle: service.shortTitle,
    body: service.body,
    href: `/soluciones/${solutionSlugs[service.id]}/`,
    tags: [...service.tags],
    image: await createResponsiveMedia({
      src: service.image,
      widths: [480, 720, 960, 1280],
      sizes: '(min-width: 901px) 640px, 72vw',
      alt: service.imageAlt,
      quality: 88,
    }),
  })),
);
---

<section id="servicios" class="services" data-section="solutions" aria-labelledby="services-title">
  <div class="site-shell">
    <div class="services__intro">
      <h2 id="services-title" data-reveal="lines">{c.solutionsIntro.title}</h2>
      <p data-reveal="fade">{c.solutionsIntro.body}</p>
    </div>

    <SolutionsRoster items={items} client:visible />
  </div>
</section>

<script>
  // Publica la altura del intro para que la foto de la lista suba a su nivel.
  const section = document.querySelector<HTMLElement>('#servicios');
  const intro = section?.querySelector<HTMLElement>('.services__intro');
  if (section && intro) {
    const sync = () => section.style.setProperty('--intro-h', `${intro.offsetHeight}px`);
    new ResizeObserver(sync).observe(intro);
    sync();
  }
</script>
