---
import { ArrowRightIcon } from '@phosphor-icons/react/dist/ssr';
import { getImage } from 'astro:assets';
import { homeContent as c } from '@/content/home';

const hero = c.hero;
const titleAccent = 'el control de su planta';
const mobileWidths = [720, 960, 1280] as const;
const desktopWidths = [720, 1080, 1448] as const;

const createSet = async (
  widths: readonly number[],
  format: 'avif' | 'webp',
  quality: number,
  square = false,
) =>
  Promise.all(
    widths.map((width) =>
      getImage({
        src: hero.art,
        width,
        ...(square ? { height: width, fit: 'cover' as const, position: 'center' } : {}),
        format,
        quality,
      }),
    ),
  );

const [mobileAvif, mobileWebp, desktopAvif, desktopWebp] = await Promise.all([
  createSet(mobileWidths, 'avif', 80),
  createSet(mobileWidths, 'webp', 82),
  createSet(desktopWidths, 'avif', 90),
  createSet(desktopWidths, 'webp', 90),
]);
const srcSet = (variants: Awaited<ReturnType<typeof createSet>>, widths: readonly number[]) =>
  variants.map((variant, index) => `${variant.src} ${widths[index]}w`).join(', ');
const fallback = desktopWebp.at(-1);
if (!fallback) throw new Error('No se pudo preparar la imagen principal');
---

<section class="hero-light" data-section="hero" data-hero-dark aria-labelledby="hero-title">
  <figure class="hero-light__art">
    <picture>
      <source
        media="(max-width: 900px)"
        srcset={srcSet(mobileAvif, mobileWidths)}
        sizes="100vw"
        type="image/avif"
      />
      <source
        media="(max-width: 900px)"
        srcset={srcSet(mobileWebp, mobileWidths)}
        sizes="100vw"
        type="image/webp"
      />
      <source srcset={srcSet(desktopAvif, desktopWidths)} sizes="100vw" type="image/avif" />
      <source srcset={srcSet(desktopWebp, desktopWidths)} sizes="100vw" type="image/webp" />
      <img
        src={fallback.src}
        srcset={srcSet(desktopWebp, desktopWidths)}
        sizes="100vw"
        alt={hero.artAlt}
        width={hero.art.width}
        height={hero.art.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </figure>

  <div class="site-shell hero-light__grid">
    <div class="hero-light__copy">
      <h1 id="hero-title">
        {
          hero.title.endsWith(titleAccent) ? (
            <>
              {hero.title.slice(0, -titleAccent.length)}
              <span class="hero-light__title-accent">{titleAccent}</span>
            </>
          ) : (
            hero.title
          )
        }
      </h1>
      <p class="hero-light__lead">{hero.lead}</p>

      <div class="hero-light__actions">
        <button class="brand-button brand-button--on-dark" type="button" data-open-quote="proyecto">
          Plantear un proyecto
        </button>
        <a class="text-link text-link--on-dark" href="/casos-de-exito/">
          Ver casos
          <ArrowRightIcon aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</section>
