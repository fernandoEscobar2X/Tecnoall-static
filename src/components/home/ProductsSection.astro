---
import { ArrowRightIcon } from '@phosphor-icons/react/dist/ssr';
import SolutionsScaleCarousel from '@components/home/SolutionsScaleCarousel';
import { homeContent as c } from '@/content/home';
import conexionWagoImage from '@assets/tecnoall/home/conexion-wago-221-transparent.webp';
import gabineteRittalImage from '@assets/tecnoall/home/gabinete-rittal-transparent.webp';
import plcSiemensImage from '@assets/tecnoall/home/plc-siemens-s7-1200-transparent.webp';
import drivesImage from '@assets/tecnoall/home/variadores-siemens-transparent.webp';
import hmiImage from '@assets/tecnoall/home/hmi-siemens-transparent.webp';
import automationImage from '@assets/tecnoall/home/automatizacion-wago-transparent.webp';
import { createResponsiveMedia } from '@lib/responsive-media';

/** Seis familias de Siemens, WAGO y Rittal. El carrusel 3D es el único componente de la sección. */
const featuredIds = [
  'product-plc',
  'product-drives',
  'product-hmi',
  'product-connectivity',
  'product-automation',
  'product-enclosures',
] as const;

const homeArt = {
  'product-drives': { image: drivesImage, imageAlt: 'Variador Siemens SINAMICS' },
  'product-hmi': { image: hmiImage, imageAlt: 'Paneles HMI Siemens' },
  'product-automation': { image: automationImage, imageAlt: 'Automatización y E/S WAGO' },
  'product-plc': { image: plcSiemensImage, imageAlt: 'PLC Siemens SIMATIC S7-1200' },
  'product-connectivity': {
    image: conexionWagoImage,
    imageAlt: 'Conector WAGO 221 de tecnología de conexión',
  },
  'product-enclosures': { image: gabineteRittalImage, imageAlt: 'Gabinete industrial Rittal' },
} as const;

const featured = featuredIds
  .map((id) => {
    const product = c.products.find((item) => item.id === id);
    if (!product) return null;
    const art = id in homeArt ? homeArt[id as keyof typeof homeArt] : null;
    return {
      ...product,
      image: art?.image ?? product.image,
      imageAlt: art?.imageAlt ?? product.imageAlt,
    };
  })
  .filter((product) => product !== null);

const slides = await Promise.all(
  featured.map(async (product) => ({
    id: product.id,
    index: product.index,
    title: product.title,
    shortTitle: product.brand,
    body: product.body,
    href: `/productos/?marca=${encodeURIComponent(product.brand)}#${product.id}`,
    image: await createResponsiveMedia({
      src: product.image,
      // Incluye el original para pantallas de alta densidad, sin inventar resolución.
      widths: [240, 360, 480, 640, 840, 1024, 1260, product.image.width],
      sizes: '(max-width: 640px) 62vw, (max-width: 857px) 240px, (max-width: 1500px) 28vw, 420px',
      alt: product.imageAlt,
      quality: 92,
    }),
  })),
);
---

<section id="productos" class="products" data-section="products" aria-labelledby="products-title">
  <div class="site-shell">
    <header class="section-heading section-heading--products">
      <div>
        <h2 id="products-title" data-reveal="lines">
          El equipo que integramos, también a su alcance
        </h2>
        <p data-reveal="fade">
          PLC, variadores, HMI, conexión y gabinetes de Siemens, WAGO y Rittal.
        </p>
      </div>
      <a href="/productos/" data-reveal="fade">
        Ver el catálogo
        <ArrowRightIcon aria-hidden="true" width={16} height={16} />
      </a>
    </header>
  </div>

  <SolutionsScaleCarousel
    slides={slides}
    label="Familias de producto de Tecno All"
    variant="product"
    client:idle={{ timeout: 100 }}
  />
</section>
