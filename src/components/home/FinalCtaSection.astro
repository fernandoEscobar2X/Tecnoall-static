---
import ContactAndLocations, { type Sede } from '@components/home/ContactAndLocations';
import { homeContent as c } from '@/content/home';
import { createResponsiveMedia } from '@lib/responsive-media';
import equipo from '@assets/tecnoall/sesion/tecnicos-rittal-tablero-vertical.webp';

const image = await createResponsiveMedia({
  src: equipo,
  widths: [480, 640, 768, 960, 1320],
  sizes: '(min-width: 1024px) 660px, calc(100vw - 40px)',
  alt: 'Técnicos de Tecno All revisando un tablero de control',
  quality: 85,
});

const maps = [c.maps.tijuana, c.maps.mexicali];
const sedes: Sede[] = c.trust.locations.map((location, index) => ({
  city: location.city,
  role: location.role,
  address: location.address,
  phone: location.phone,
  phoneHref: location.phoneHref,
  directionsHref: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location.address)}`,
  mapSrc: maps[index]!,
}));
---

<ContactAndLocations
  client:visible
  title="Ponga su próximo proyecto en marcha"
  body={c.finalCta.body}
  whatsappHref={c.contact.whatsappHref}
  image={{
    src: image.src,
    srcSet: image.srcSet,
    width: image.width,
    height: image.height,
    alt: image.alt,
  }}
  sedes={sedes}
/>
