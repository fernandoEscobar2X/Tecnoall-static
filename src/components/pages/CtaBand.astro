---
interface Props {
  title: string;
  body?: string;
  tone?: 'deep' | 'accent' | 'paper';
}

const { title, body, tone = 'deep' } = Astro.props;
const secondaryClass = tone === 'paper' ? 'text-link' : 'text-link text-link--on-dark';
---

<section class:list={['cta-band', `cta-band--${tone}`]}>
  <div class="site-shell cta-band__inner">
    <div>
      <h2>{title}</h2>
      {body && <p>{body}</p>}
    </div>
    <div class="cta-band__actions">
      <slot>
        <button class="brand-button" type="button" data-open-quote>Solicitar cotización</button>
        <a class={secondaryClass} href="/empresa/#escribanos">Escribir al equipo</a>
      </slot>
    </div>
  </div>
</section>
