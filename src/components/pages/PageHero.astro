---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  lead?: string;
  image: ImageMetadata;
  imageAlt?: string;
  compact?: boolean;
}

const { title, lead, image, imageAlt = '', compact = false } = Astro.props;
---

<section class:list={['about-hero', { 'about-hero--compact': compact }]}>
  <figure class="about-hero__media" aria-hidden={imageAlt === '' ? 'true' : undefined}>
    <Image
      src={image}
      alt={imageAlt}
      widths={[480, 720, 960, 1440]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </figure>
  <div class="about-hero__shade" aria-hidden="true"></div>

  <div class="site-shell about-hero__content">
    <h1>{title}</h1>
    {lead && <p class="about-hero__lead">{lead}</p>}

    {
      Astro.slots.has('actions') && (
        <div class="about-hero__actions">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>
