---
import CasesPreview from '@components/home/CasesPreview.astro';
import FinalCtaSection from '@components/home/FinalCtaSection.astro';
import HeroSection from '@components/home/HeroSection.astro';
import LocationsSection from '@components/home/LocationsSection.astro';
import ProductsSection from '@components/home/ProductsSection.astro';
import SolutionsSection from '@components/home/SolutionsSection.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { homeContent as c } from '@/content/home';
import { pageSchema } from '@lib/seo/schema';

const title = 'Automatización y control industrial';
const description = c.company.description;
---

<SiteLayout
  seo={{
    title,
    description,
    image: '/og/corporativo.png',
    imageAlt: 'Proyecto de automatización industrial desarrollado por Tecno All',
    jsonLd: pageSchema({
      name: title,
      description,
      path: '/',
      image: '/og/corporativo.png',
      includeLocations: true,
    }),
  }}
>
  <HeroSection />
  <SolutionsSection />
  <ProductsSection />
  <CasesPreview />
  <LocationsSection />
  <FinalCtaSection />
</SiteLayout>
