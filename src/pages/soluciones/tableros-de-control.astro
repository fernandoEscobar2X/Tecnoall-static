---
import { Image } from 'astro:assets';
import PageHero from '@components/pages/PageHero.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { solutionPages } from '@/content/routes';
import { siteConfig } from '@config/site';
import { pageSchema, serviceSchema } from '@lib/seo/schema';
import { getCaseStageImage } from '@/content/cases';

import tableroAlambrado from '@assets/tecnoall/sesion/tablero-plc-alambrado.webp';
import tableroInterior from '@assets/tecnoall/sesion/tablero-control-interior-vertical.webp';
import tableroPotencia from '@assets/tecnoall/sesion/tablero-potencia-interior.webp';
import rittalLogo from '@assets/tecnoall/logos-transparent/logo-rittal.png';
import wagoLogo from '@assets/tecnoall/logos-transparent/logo-wago.png';
import eplanLogo from '@assets/tecnoall/logos-transparent/logo-eplan2.png';
import siemensLogo from '@assets/tecnoall/logos-transparent/logo-siemens.png';
import carloLogo from '@assets/tecnoall/logos-transparent/logo-carlo.png';

const panelesInstalados = getCaseStageImage('planta-desalinizadora', 'stage-control-panels');
const solution = solutionPages.find((item) => item.id === 'solution-panels')!;
const canonical = `${siteConfig.siteUrl}/soluciones/${solution.slug}/`;

const brands = [
  { name: 'Rittal', logo: rittalLogo },
  { name: 'WAGO', logo: wagoLogo },
  { name: 'EPLAN', logo: eplanLogo },
  { name: 'Siemens', logo: siemensLogo },
  { name: 'Carlo Gavazzi', logo: carloLogo },
];
---

<SiteLayout
  seo={{
    title: solution.title,
    description: solution.body,
    image: '/og/soluciones.png',
    imageAlt: 'Supervisión de un proceso industrial mediante PLC y SCADA',
    jsonLd: pageSchema({
      name: solution.title,
      description: solution.body,
      path: `/soluciones/${solution.slug}/`,
      image: '/og/soluciones.png',
      breadcrumbs: [
        { name: 'Inicio', path: '/' },
        { name: 'Soluciones', path: '/soluciones/' },
        { name: solution.title, path: `/soluciones/${solution.slug}/` },
      ],
      mainEntityId: `${canonical}#service`,
      additionalNodes: [
        serviceSchema({ name: solution.title, description: solution.body, url: canonical }),
      ],
    }),
  }}
>
  <PageHero
    title="Diseño y fabricación de tableros de control"
    lead="Diseñamos, integramos y fabricamos tableros de control y distribución bajo normas NEMA e IEC. Realizamos ingeniería eléctrica en EPLAN, ensamble en taller propio en Tijuana y puesta en marcha en sitio."
    image={tableroAlambrado}
    imageAlt="Tablero de control con PLC Siemens S7-1500 alambrado en el taller de Tecno All"
  >
    <Fragment slot="actions">
      <button class="about-hero__brochure" type="button" data-open-quote="proyecto">
        Plantear un proyecto
      </button>
    </Fragment>
  </PageHero>

  <article class="tab-page">
    <section class="tab-work" aria-labelledby="work-title">
      <div class="site-shell">
        <div class="tab-work__intro">
          <h2 id="work-title" class="tab-work__title">Hechos en nuestro taller</h2>
          <p class="tab-work__text">
            Cada tablero se arma con canalización estructurada, borneras identificadas y el cableado
            de potencia separado de las señales de control.
          </p>
        </div>

        <div class="tab-work__gallery">
          <figure class="tab-work__figure tab-work__figure--main">
            <Image
              src={tableroPotencia}
              alt="Interior de un tablero de potencia y control armado por Tecno All"
              class="tab-work__img"
              widths={[900, 1300, 1800]}
              sizes="(max-width: 900px) 100vw, 68vw"
            />
          </figure>

          <figure class="tab-work__figure tab-work__figure--sub">
            <Image
              src={tableroInterior}
              alt="Tablero de control con PLC y bornas identificadas, fabricado por Tecno All"
              class="tab-work__img"
              widths={[600, 900, 1200]}
              sizes="(max-width: 900px) 100vw, 42vw"
            />
          </figure>
        </div>
      </div>
    </section>

    <section class="tab-scope" aria-labelledby="scope-title">
      <div class="site-shell">
        <header class="tab-scope__header">
          <h2 id="scope-title" class="tab-scope__title">De la ingeniería al arranque</h2>
        </header>

        <div class="tab-scope__grid">
          <div class="tab-scope__col">
            <h3 class="tab-scope__item-title">En ingeniería</h3>
            <p class="tab-scope__item-desc">
              Levantamos los requerimientos en sitio y desarrollamos diagramas y listas de
              materiales en EPLAN. Seleccionamos el gabinete Rittal, calculamos la climatización y
              especificamos protecciones, PLC y comunicación.
            </p>
          </div>
          <div class="tab-scope__col">
            <h3 class="tab-scope__item-title">En el taller y en planta</h3>
            <p class="tab-scope__item-desc">
              Montamos, alambramos y ferrulamos cada señal. Hacemos pruebas FAT en taller y
              acompañamos la energización y el arranque en su planta, con planos as-built.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="tab-eco" aria-labelledby="eco-title">
      <div class="site-shell">
        <h2 id="eco-title" class="tab-eco__title">Con las marcas que ya usa su planta</h2>
        <p class="tab-eco__subtitle">
          Rittal en envolventes y climatización, WAGO en conexión, EPLAN en ingeniería, Siemens en
          control y Carlo Gavazzi en sensores y monitoreo.
        </p>

        <ul class="tab-eco__list">
          {
            brands.map((brand) => (
              <li class="tab-eco__brand-box">
                <Image src={brand.logo} alt={brand.name} class="tab-eco__logo" width={160} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="tab-installed" aria-label="Tableros instalados en planta">
      <div class="site-shell">
        <figure class="tab-installed__figure">
          <Image
            src={panelesInstalados}
            alt="Fila de tableros de control instalados y operando en planta"
            class="tab-installed__img"
            widths={[900, 1400, 2000]}
            sizes="100vw"
          />
        </figure>
      </div>
    </section>

    <section class="tab-case-ref" aria-labelledby="case-ref-title">
      <div class="site-shell tab-case-ref__inner">
        <div class="tab-case-ref__copy">
          <h2 id="case-ref-title" class="tab-case-ref__title">
            Tableros de control y fuerza para PBAR4, en Mexicali
          </h2>
          <p class="tab-case-ref__desc">
            Tableros CCM, arrancadores suaves y cajas de automatización para infraestructura de
            bombeo en Baja California.
          </p>
          <a href="/casos-de-exito/#tableros-pbar4-mexicali" class="tab-case-ref__link">
            <span>Ver el caso</span>
          </a>
        </div>
      </div>
    </section>

    <section class="tab-close" aria-labelledby="tab-close-title">
      <div class="site-shell tab-close__inner">
        <div class="tab-close__left">
          <h2 id="tab-close-title" class="tab-close__title">
            ¿Tiene un tablero por diseñar, actualizar o integrar?
          </h2>
          <p class="tab-close__desc">
            Envíenos sus diagramas o la especificación del proceso y le cotizamos el tablero
            completo.
          </p>
        </div>

        <div class="tab-close__right">
          <button
            class="brand-button brand-button--on-dark"
            type="button"
            data-open-quote="proyecto"
          >
            Plantear un proyecto
          </button>
        </div>
      </div>
    </section>
  </article>
</SiteLayout>
