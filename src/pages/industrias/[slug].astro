---
import { Image } from 'astro:assets';
import CtaBand from '@components/pages/CtaBand.astro';
import PageHero from '@components/pages/PageHero.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { industryPages, type IndustryPage } from '@/content/routes';
import { homeContent } from '@/content/home';
import { caseStudies } from '@/content/cases';
import { solutionsForIndustry } from '@/content/graph';
import desalinationPanelsImage from '@assets/tecnoall/casos/desalinizadora/paneles-control.webp';
import serviceImage from '@assets/tecnoall/industria/instalacion-servicios.png';

export function getStaticPaths() {
  return industryPages.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

interface Props {
  industry: IndustryPage;
}
const { industry } = Astro.props;
const related = industryPages.filter((item) => item.id !== industry.id);
const solutions = solutionsForIndustry(industry.id);
const projects = caseStudies.filter((caseStudy) => caseStudy.industry === industry.title);
const hero =
  industry.id === 'industry-process'
    ? {
        image: desalinationPanelsImage,
        imageAlt: 'Paneles de control en un módulo de proceso industrial',
      }
    : {
        image: serviceImage,
        imageAlt: 'Instalación industrial en una línea de manufactura',
      };
---

<SiteLayout
  seo={{
    title: `Automatización para ${industry.title}`,
    description: industry.body,
    noindex: true,
  }}
>
  <PageHero title={industry.title} lead={industry.body} image={hero.image} imageAlt={hero.imageAlt}>
    <Fragment slot="actions">
      <button class="about-hero__brochure" type="button" data-open-quote>
        Plantear un requerimiento
      </button>
    </Fragment>
  </PageHero>

  <section class="page-section" aria-labelledby="applications-title">
    <div class="site-shell">
      <header class="section-heading" data-reveal>
        <h2 id="applications-title">Áreas de aplicación</h2>
        <p>Cada área se puede atender sola o junto con el resto del proceso.</p>
      </header>
    </div>

    <div class="site-shell feature-rows">
      <article class="feature-row" data-reveal>
        <div class="feature-row__media">
          <Image
            src={homeContent.industryImage}
            alt={homeContent.industryImageAlt}
            widths={[640, 960, 1360]}
            sizes="(min-width: 900px) 52vw, 100vw"
          />
        </div>
        <div class="feature-row__body">
          <span class="feature-row__index">Aplicación</span>
          <ul class="spec-list" style="margin-top:22px">
            {industry.applications.map((application) => <li>{application}</li>)}
          </ul>
        </div>
      </article>
    </div>
  </section>

  <section class="page-section page-section--tint" aria-labelledby="industry-solutions-title">
    <div class="site-shell">
      <header class="section-heading" data-reveal>
        <h2 id="industry-solutions-title">Soluciones que aplican</h2>
        <p>Qué hacemos en este sector.</p>
      </header>

      <ul class="spec-list">
        {
          solutions.map((solution) => (
            <li>
              <a class="feature-row__link" href={`/soluciones/${solution.slug}/`} style="margin:0">
                {solution.title}
              </a>
            </li>
          ))
        }
        {
          related.map((item) => (
            <li>
              <a class="feature-row__link" href={`/industrias/${item.slug}/`} style="margin:0">
                Ver también: {item.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    projects.length > 0 && (
      <section class="page-section" aria-labelledby="industry-projects-title">
        <div class="site-shell">
          <header class="section-heading">
            <h2 id="industry-projects-title">Proyectos en este sector</h2>
            <p>Trabajo documentado de Tecno All en este sector.</p>
          </header>

          <ul class="spec-list">
            {projects.map((project) => (
              <li>
                <a
                  class="feature-row__link"
                  href={`/casos-de-exito/#${project.slug}`}
                  style="margin:0"
                >
                  {project.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand
    title="¿Trabaja un proceso parecido?"
    body="Cuéntenos el proceso, el equipo instalado y lo que espera lograr."
  />
</SiteLayout>
